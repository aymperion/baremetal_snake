{
    "version": "2.0.0",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
    },
    "tasks": [
        {
            "label": "Flash Firmware",
            "type": "shell",
            "command": "openocd -f board/st_nucleo_f4.cfg -c \"program build/main.hex verify reset exit\"",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Set build variant to Debug",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja -DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake -DCMAKE_BUILD_TYPE=Debug"
        },
        {
            "label": "Set build variant to Release",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja -DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake -DCMAKE_BUILD_TYPE=Release"
        },
        {
            "label": "Set build variant to RelWithDebInfo",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja -DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo"
        },
        {
            "label": "Set build variant to MinSizeRel",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja -DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake -DCMAKE_BUILD_TYPE=MinSizeRel"
        },
        {
            "label": "Build firmware",
            "type": "shell",
            "command": "cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
            
        }
    ]
}