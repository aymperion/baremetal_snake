{
    "version": "2.0.0",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
    },
    "tasks": [
        {
            "label": "Flash Firmware",
            "type": "shell",
            "command": "\"${workspaceFolder}/.venv/Scripts/python.exe\" scripts/flash.py"
        },
        {
            "label": "Enable semihosting",
            "type": "shell",
            "command": "openocd -f board/st_nucleo_f4.cfg -c \"init; arm semihosting enable;\"",
            "problemMatcher": []
        },
        {
            "label": "Configure : production (Release)",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja \"-DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake\" -DTARGET_GROUP=production -DCMAKE_BUILD_TYPE=Release"
        },
        {
            "label": "Configure : production (Debug)",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja \"-DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake\" -DTARGET_GROUP=production -DCMAKE_BUILD_TYPE=Debug"
        },
        {
            "label": "Configure : production (RelWithDebInfo)",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja \"-DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake\" -DTARGET_GROUP=production -DCMAKE_BUILD_TYPE=RelWithDebInfo"
        },
        {
            "label": "Configure : production (MinSizeRel)",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja \"-DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake\" -DTARGET_GROUP=production -DCMAKE_BUILD_TYPE=MinSizeRel"
        },
        {
            "label": "Configure : test (Release)",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja \"-DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake\" -DTARGET_GROUP=test -DCMAKE_BUILD_TYPE=Release"
        },
        {
            "label": "Configure : test (Debug)",
            "type": "shell",
            "command": "cmake -B build -S . -G Ninja \"-DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake\" -DTARGET_GROUP=test -DCMAKE_BUILD_TYPE=Debug"
        },
        {
            "label": "Build firmware",
            "type": "shell",
            "command": "cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}