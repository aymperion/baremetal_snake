{
  "clangd.path": "c:\\Users\\Aymeric\\AppData\\Roaming\\Code\\User\\globalStorage\\llvm-vs-code-extensions.vscode-clangd\\install\\22.1.6\\clangd_22.1.6\\bin\\clangd.exe",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.ignore": ["*"],
  "cortex-debug.armToolchainPath": "C:\\Program Files\\Arm\\GNU Toolchain mingw-w64-x86_64-arm-none-eabi\\bin",
  "cortex-debug.variableUseNaturalFormat": false,
  
  "betterStatusBar.defaultColor": "statusBar.foreground",
  "betterStatusBar.reloadButton": "$(refresh)",
  "betterStatusBar.commands": [
    {
      "id": "flash",
      "label": "$(zap)",
      "useVsCodeApi": true,
      "command": "workbench.action.tasks.runTask",
      "args": [
        "Flash Firmware"
      ],
      "tooltip": "Flash newest firmware (Auto: production or test)",
      "priority": -2
    },
    {
      "id": "cmake-config-release",
      "label": "$(package) Release",
      "useVsCodeApi": true,
      "command": "workbench.action.tasks.runTask",
      "args": [
        "Configure : production (Release)"
      ],
      "showButton": false
    },
    {
      "id": "cmake-config-debug",
      "label": "$(bug) Debug",
      "useVsCodeApi": true,
      "command": "workbench.action.tasks.runTask",
      "args": [
        "Configure : production (Debug)"
      ],
      "showButton": false
    },
    {
      "id": "cmake-config-relwithdebinfo",
      "label": "$(package) Release with Debug Info",
      "useVsCodeApi": true,
      "command": "workbench.action.tasks.runTask",
      "args": [
        "Configure : production (RelWithDebInfo)"
      ],
      "showButton": false
    },
    {
      "id": "cmake-config-minsizerel",
      "label": "$(package) Minimise binary size",
      "useVsCodeApi": true,
      "command": "workbench.action.tasks.runTask",
      "args": [
        "Configure : production (MinSizeRel)"
      ],
      "showButton": false
    },
    {
      "id": "cmake-config-test-release",
      "label": "$(beaker) Release",
      "useVsCodeApi": true,
      "command": "workbench.action.tasks.runTask",
      "args": [
        "Configure : test (Release)"
      ],
      "showButton": false
    },
    {
      "id": "cmake-config-test-debug",
      "label": "$(beaker) Debug",
      "useVsCodeApi": true,
      "command": "workbench.action.tasks.runTask",
      "args": [
        "Configure : test (Debug)"
      ],
      "showButton": false
    },
    {
      "id": "cmake-build",
      "label": "$(tools)",
      "useVsCodeApi": true,
      "command": "workbench.action.tasks.runTask",
      "args": [
        "Build firmware"
      ],
      "tooltip": "Compile main.elf, compute binary size and generate .hex/.bin files",
      "priority": -1
    }
  ],
  "betterStatusBar.dropdowns": [
    {
      "id": "cmakeBuildTypeDropdown",
      "label": "$(gear) Build type",
      "commands": [
        "cmake-config-release",
        "cmake-config-debug",
        "cmake-config-relwithdebinfo",
        "cmake-config-minsizerel",
        "cmake-config-test-release",
        "cmake-config-test-debug"
      ],
      "options": {
        "placeholder": "Select a build variant",
        "title": "CMake configuration"
      },
      "priority": 0
    }
  ]
}